# .env.local

# 1. Database Connection (PostgreSQL/Supabase/Neon)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# 2. OpenRouter API Key (Saare AI Models yahi se chalenge)
OPENROUTER_API_KEY="sk-or-v1-aapki-secret-key-yahan"

# 3. Payment Gateway (Stripe / Razorpay)
STRIPE_SECRET_KEY="sk_test_123456789"
STRIPE_WEBHOOK_SECRET="whsec_123456789"

# 4. App URL (Deployment ke baad yahan live URL aayega)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
