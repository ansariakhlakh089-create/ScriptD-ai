# ============================================================
# .env.example  ->  copy karke .env.local banao (.env.local KABHI GitHub par mat daalna)
# Vercel par yahi saari values Project Settings > Environment Variables mein daalo
# ============================================================

# ---------- 1. Database (Supabase) ----------
# Supabase > Project > Connect > ORMs > Prisma se dono URL copy karo
# DATABASE_URL = Transaction pooler (port 6543) + ?pgbouncer=true
DATABASE_URL="postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-xxxx.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL = Session pooler / direct (port 5432) - sirf `prisma db push` ke liye
DIRECT_URL="postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-xxxx.pooler.supabase.com:5432/postgres"

# ---------- 2. Login (Better Auth) ----------
# Secret banane ke liye terminal mein chalao:  openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Local: http://localhost:3000   |   Live: https://tumhara-domain.vercel.app
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google login (Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web))
# Redirect URI daalna: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------- 3. Email OTP (Resend) ----------
# Bina key ke local mein OTP terminal mein print hoga (production mein nahi chalega)
# Sabko mail bhejne ke liye Resend par apna domain verify karna padega
RESEND_API_KEY=""
EMAIL_FROM="ScriptD AI <onboarding@resend.dev>"

# ---------- 4. AI (OpenRouter - ek hi key se saare models) ----------
OPENROUTER_API_KEY=""
# Model slugs openrouter.ai/models se dekhkar Part 2 mein bharenge (abhi khaali chhodo)
MODEL_FREE_RESEARCH=""
MODEL_FREE_SCRIPT=""
MODEL_FREE_VPROMPT=""
MODEL_PAID_RESEARCH=""
MODEL_PAID_SCRIPT=""
MODEL_PAID_VPROMPT=""
MODEL_CHAT=""

# ---------- 5. Payments (Razorpay) ----------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
