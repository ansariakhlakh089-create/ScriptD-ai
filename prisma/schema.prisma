generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  plan      String   @default("FREE")
  tokens    Int      @default(3000)
  createdAt DateTime @default(now())
}
