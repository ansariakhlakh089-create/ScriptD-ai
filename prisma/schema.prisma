generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  credits   Int      @default(5) // User ke credits
  chats     Chat[]
}

model Chat {
  id         String   @id @default(cuid())
  userId     String
  topic      String
  type       String
  tone       String
  status     String   @default("researching") // researching, writing_script, done
  
  research   String?  @db.Text
  script     String?  @db.Text
  vPrompt    String?  @db.Text
  
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
}
